# ── Quant Engine v20 — environment configuration ─────────────────────────
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.

# --- Exchange credentials (REQUIRED) -------------------------------------
ARIAX_KEY=
ARIAX_SECRET=
ARIAX_BASE=https://dryclean-app-1.onrender.com
# ARIAX_RECV_WINDOW=5000
# ARIAX_TIMEOUT=55
# ARIAX_CONNECT_TIMEOUT=25
# ARIAX_MAX_RETRIES=4
# ARIAX_RETRY_BASE=4.0

# --- Telegram notifications (optional; engine runs without it) -----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Risk management ------------------------------------------------------
RISK_PCT=0.40          # % of free margin risked per trade
MAX_DD=10.0            # % drawdown halt
MAX_DAILY_LOSS=5.0     # % daily loss halt
LEVERAGE=5
MAX_POS=5
MAX_NOTIONAL_USD=80.0
MAX_AGG_NOTIONAL_USD=240.0
MIN_ORDER_USD=8.0
MIN_FREE_MARGIN=15.0
MARGIN_UTIL_CAP=0.85
MARGIN_RESERVE_FACTOR=0.65
MIN_STOP_PCT=0.003
TAKER_FEE=0.0005
FEE_BUFFER=1.2

# --- Strategies (v20.1 think-tank selection) --------------------------------
# Only HTF_Breakout (long-only) passed the real-data screening. The rest are
# disabled by default but re-enableable for research, e.g.:
#   ENABLED_STRATEGIES=HTF_Breakout,TrendPullback_HTF,MomentumRetrace_RSI,...
ENABLED_STRATEGIES=HTF_Breakout
SIDES=long
MAX_DAILY_ENTRIES=8

# --- Adaptive risk (self-healing governor) --------------------------------
ADAPTIVE_RISK=true
ADAPT_DD_BAND1=5.0
ADAPT_DD_BAND2=7.5
LOSS_STREAK_SHRINK_AT=3
LOSS_STREAK_FACTOR=0.6
AUTO_RESUME_DD_RATIO=0.5

# --- Position management --------------------------------------------------
PARTIAL_TP=true
MIN_HOLD_FOR_PARTIAL=720
MIN_HOLD_FOR_TRAIL=1080
MIN_PROFIT_FOR_BE=0.75
TRAIL_ACT=3.2
TRAIL_STEP=1.0
USE_ATR_TRAIL=true
ATR_TRAIL_MULT=0.8
MAX_HOLD_SECONDS=14400

# --- Timing / cooldowns ---------------------------------------------------
SCAN_INTERVAL=70
SYMBOL_DELAY=2.0
OHLCV_PAUSE=1.2
SYNC_INTERVAL=60
PRICE_INTERVAL=15
ENTRY_COOLDOWN=3600
POST_CLOSE_COOLDOWN=1200
ERROR_COOLDOWN_BASE=120
ERROR_COOLDOWN_MAX=1800
GHOST_MISS_LIMIT=3

# --- Data feed ------------------------------------------------------------
CLOSE_ON_DATA_STALL=true
DATA_STALL_GRACE=600

# --- Misc -----------------------------------------------------------------
PORT=10000
LOG_LEVEL=INFO
# LOG_FILE=quant.log
# TEST_SYMBOL=ETHUSD
# TEST_USD=15.0
# SEND_CLIENT_OID=false
