# ── Quant Engine v20 — environment configuration ─────────────────────────
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.

# --- SAFETY: paper mode (v20.5) -------------------------------------------
# true  = full pipeline runs, fills are simulated locally, NOTHING is sent to
#         the exchange. This is the shipped default.
# false = real orders. Only flip this after a paper run shows positive
#         expectancy over a meaningful number of trades — no strategy in this
#         repo has demonstrated a post-cost edge yet (analysis/AUDIT_v20.5.md).
PAPER_MODE=true

# --- Exchange credentials (REQUIRED) -------------------------------------
ARIAX_KEY=
ARIAX_SECRET=
ARIAX_BASE=https://dryclean-app-1.onrender.com
# ARIAX_RECV_WINDOW=5000
# ARIAX_TIMEOUT=55
# ARIAX_CONNECT_TIMEOUT=25
# ARIAX_MAX_RETRIES=4
# ARIAX_RETRY_BASE=4.0

# --- Telegram notifications (optional; engine runs without it) -----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Risk management ------------------------------------------------------
RISK_PCT=0.40          # % of free margin risked per trade
MAX_DD=10.0            # % drawdown halt
MAX_DAILY_LOSS=5.0     # % daily loss halt
LEVERAGE=5
MAX_POS=5
MAX_NOTIONAL_USD=80.0
MAX_AGG_NOTIONAL_USD=400.0   # must cover MAX_POS x MAX_NOTIONAL_USD
MIN_ORDER_USD=8.0
MIN_FREE_MARGIN=15.0
MARGIN_UTIL_CAP=0.85
MARGIN_RESERVE_FACTOR=0.65
MIN_STOP_PCT=0.003
TAKER_FEE=0.0005
FEE_BUFFER=1.2
SLIPPAGE_PCT=0.0002    # expected slippage per side (fraction of price)
# Cost gate: a signal's take-profit must be >= MIN_EDGE_RATIO x the modelled
# round-trip cost, else the trade is skipped. This is the direct fix for the
# root cause of the losing versions (edge per trade < cost per trade).
MIN_EDGE_RATIO=3.0

# --- Strategies (v20.5 selection) -------------------------------------------
# CORRECTION to v20.4: the screening report concluded "None passed", and a
# fresh 5-seed hold-out re-run ranked HTF_Breakout LAST (-1.25% avg, 0/5
# seeds positive). Defaults are now the lowest-drawdown families measured.
# None of them is proven profitable — hence PAPER_MODE=true above.
ENABLED_STRATEGIES=MeanReversion_BB,VolatilityExpansion
SIDES=long
MAX_DAILY_ENTRIES=12

# --- Funding gate (v20.4) --------------------------------------------------
# 0 = disabled (AriaX testnet reports a static placeholder funding of 0.75
# for most symbols — see config.py). On a real exchange set e.g. 0.10.
FUNDING_MAX_PCT=0

# --- Stuck-position protection (v20.4) --------------------------------------
RECOVER_COOLDOWN=1800
MAX_RECOVER_CYCLES=3
CLOSE_VERIFY_RECHECK=3600

# --- Dashboard (optional shared secret) --------------------------------------
# When set, every route except /health requires ?token=... to match.
# DASH_TOKEN=some-long-random-string

# --- Adaptive risk (self-healing governor) --------------------------------
ADAPTIVE_RISK=true
ADAPT_DD_BAND1=5.0
ADAPT_DD_BAND2=7.5
LOSS_STREAK_SHRINK_AT=3
LOSS_STREAK_FACTOR=0.6
AUTO_RESUME_DD_RATIO=0.5

# --- Position management --------------------------------------------------
# v20.5: partial TP halved every winner but never a loser, and the 4h time
# stop closed 55/85 trades before the target could be reached (pure fee burn).
PARTIAL_TP=false
MIN_HOLD_FOR_PARTIAL=720
MIN_HOLD_FOR_TRAIL=1080
MIN_PROFIT_FOR_BE=0.75
TRAIL_ACT=6.0
TRAIL_STEP=1.0
USE_ATR_TRAIL=true
ATR_TRAIL_MULT=2.0
MAX_HOLD_SECONDS=172800   # 48h — was 4h, which cut winners short

# --- Timing / cooldowns ---------------------------------------------------
SCAN_INTERVAL=70
SYMBOL_DELAY=2.0
OHLCV_PAUSE=1.2
SYNC_INTERVAL=60
PRICE_INTERVAL=15
ENTRY_COOLDOWN=900
POST_CLOSE_COOLDOWN=600
ERROR_COOLDOWN_BASE=120
ERROR_COOLDOWN_MAX=1800
GHOST_MISS_LIMIT=3

# --- Data feed ------------------------------------------------------------
CLOSE_ON_DATA_STALL=true
DATA_STALL_GRACE=600

# --- Misc -----------------------------------------------------------------
PORT=10000
LOG_LEVEL=INFO
# LOG_FILE=quant.log
# TEST_SYMBOL=ETHUSD
# TEST_USD=15.0
# SEND_CLIENT_OID=false
