# ── Quant Engine v21 — environment configuration ─────────────────────────
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.

# --- SAFETY: paper mode (v20.5, re-validated in v21) -----------------------
# true  = full pipeline runs, fills are simulated locally, NOTHING is sent to
#         the exchange. This is the shipped default.
# false = real orders. The v21 Donchian_Trend setup is validated on 30 months
#         of real data in two independent windows (analysis/STRATEGY_v21.0.md:
#         +7.06% / PF 1.41 on 14mo Binance; +6.69% / PF 1.28 on 16mo OKX never
#         seen). STILL: only flip this after a paper run meets every gate in
#         GO_LIVE_CHECKLIST.md — validation is evidence of an edge, not a
#         license to skip the run-up.
PAPER_MODE=true

# --- Exchange credentials (REQUIRED) -------------------------------------
ARIAX_KEY=
ARIAX_SECRET=
ARIAX_BASE=https://dryclean-app-1.onrender.com
# ARIAX_RECV_WINDOW=5000
# ARIAX_TIMEOUT=55
# ARIAX_CONNECT_TIMEOUT=25
# ARIAX_MAX_RETRIES=4
# ARIAX_RETRY_BASE=4.0

# --- Telegram notifications (optional; engine runs without it) -----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Risk management ------------------------------------------------------
RISK_PCT=0.40          # % of free margin risked per trade
MAX_DD=10.0            # % drawdown halt
MAX_DAILY_LOSS=5.0     # % daily loss halt
LEVERAGE=5
MAX_POS=5
MAX_NOTIONAL_USD=80.0
MAX_AGG_NOTIONAL_USD=400.0   # must cover MAX_POS x MAX_NOTIONAL_USD
MIN_ORDER_USD=8.0
MIN_FREE_MARGIN=15.0
MARGIN_UTIL_CAP=0.85
MARGIN_RESERVE_FACTOR=0.65
MIN_STOP_PCT=0.003
TAKER_FEE=0.0005
FEE_BUFFER=1.2
SLIPPAGE_PCT=0.0002    # expected slippage per side (fraction of price)
# Cost gate: a signal's take-profit must be >= MIN_EDGE_RATIO x the modelled
# round-trip cost, else the trade is skipped. This is the direct fix for the
# root cause of the losing versions (edge per trade < cost per trade).
MIN_EDGE_RATIO=3.0

# --- Strategy v22: long-side distance gate ----------------------------------
# Long breakouts must clear the slow EMA by N x ATR before being taken
# (shorts are never affected). 0 = off. The shipped default is set from the
# two-window sweep in analysis/runs/sweep_long_gate_v22.json — see
# analysis/STRATEGY_v22.md before changing it.
DONCHIAN_LONG_DIST_ATR=1.0

# --- Telegram (v22) ----------------------------------------------------------
# Master switch for per-trade messages (open/close). Halt/error alerts are
# always sent. true = receive trade messages.
TG_NOTIFY_TRADES=true

# --- Strategies (v20.6) -----------------------------------------------------
# v20.6: Donchian_Trend, validated on 14 months of REAL Binance 1h data
# (+5.52%, PF 1.33, maxDD 4.04% — analysis/STRATEGY_v20.6.md). All six legacy
# families lose out-of-sample on the same data and are kept for research only.
ENABLED_STRATEGIES=Donchian_Trend
# MUST stay "both": shorts produced the entire edge (+$61.6 vs -$6.4 long).
SIDES=both
MAX_DAILY_ENTRIES=12

# --- Funding gate (v20.4) --------------------------------------------------
# 0 = disabled (AriaX testnet reports a static placeholder funding of 0.75
# for most symbols — see config.py). On a real exchange set e.g. 0.10.
FUNDING_MAX_PCT=0

# --- Stuck-position protection (v20.4) --------------------------------------
RECOVER_COOLDOWN=1800
MAX_RECOVER_CYCLES=3
CLOSE_VERIFY_RECHECK=3600

# --- Dashboard (shared secret) -----------------------------------------------
# Review F-07: dashboard auth is ON BY DEFAULT. If DASH_TOKEN is unset, a
# random token is generated at startup and logged (search the log for
# "auto-generated token"). Set a stable token to avoid rotating it on every
# deploy. Every route except /health requires ?token=... (or X-Dash-Token).
# DASH_TOKEN=some-long-random-string

# --- Exchange auth hardening (review F-06) ------------------------------------
# The legacy /api/* contract is believed to authenticate with the raw
# X-API-Secret header, so it is sent by default (safe for a working live
# deployment). Once you have verified one private call succeeds WITHOUT it,
# set this to false so the raw secret stops leaving the process (only the
# derived HMAC header is sent afterwards).
# ARIAX_SEND_SECRET_HEADER=true

# --- Data feed sizing (review F-15) -------------------------------------------
# Primary-timeframe fetch size. CANDLE_LIMIT_PRIMARY is preferred; the legacy
# CANDLE_LIMIT_5M name still works and takes precedence if both are set.
# CANDLE_LIMIT_PRIMARY=300

# --- Adaptive risk (self-healing governor) --------------------------------
ADAPTIVE_RISK=true
ADAPT_DD_BAND1=5.0
ADAPT_DD_BAND2=7.5
LOSS_STREAK_SHRINK_AT=3
LOSS_STREAK_FACTOR=0.6
AUTO_RESUME_DD_RATIO=0.5

# --- Position management --------------------------------------------------
# v20.5: partial TP halved every winner but never a loser, and the 4h time
# stop closed 55/85 trades before the target could be reached (pure fee burn).
PARTIAL_TP=false
MIN_HOLD_FOR_PARTIAL=720
MIN_HOLD_FOR_TRAIL=3600
MIN_PROFIT_FOR_BE=0.75
TRAIL_ACT=4.0
TRAIL_STEP=1.0
USE_ATR_TRAIL=true
ATR_TRAIL_MULT=6.0
MAX_HOLD_SECONDS=1440000  # 400h — trend trades need weeks to mature

# --- Timeframes (v20.6: strategy validated on 1h bars) ----------------------
TIMEFRAME=1h
MID_TIMEFRAME=4h
HTF_TIMEFRAME=4h

# --- Timing / cooldowns ---------------------------------------------------
SCAN_INTERVAL=70
SYMBOL_DELAY=2.0
OHLCV_PAUSE=1.2
SYNC_INTERVAL=60
PRICE_INTERVAL=15
ENTRY_COOLDOWN=3600
POST_CLOSE_COOLDOWN=3600
ERROR_COOLDOWN_BASE=120
ERROR_COOLDOWN_MAX=1800
GHOST_MISS_LIMIT=3

# --- Data feed ------------------------------------------------------------
CLOSE_ON_DATA_STALL=true
DATA_STALL_GRACE=600

# --- Misc -----------------------------------------------------------------
PORT=10000
LOG_LEVEL=INFO
# LOG_FILE=quant.log
# TEST_SYMBOL=ETHUSD
# TEST_USD=15.0
# SEND_CLIENT_OID=false
